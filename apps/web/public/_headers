# Security headers for the static site (Cloudflare Workers static assets).
# Tested against the production build with `wrangler dev`; see docs/DECISIONS.md.
#
# connect-src: https:/wss: because users choose their own RPC, Helios and node
# endpoints (and the Anon-RPC host downloads hash-pinned worker bundles from
# resolvers it reads on-chain); http://127.0.0.1 / localhost for a local node;
# data: because Helios embeds its WASM as a data: URL. No 'unsafe-inline' and
# no 'unsafe-eval' anywhere; 'wasm-unsafe-eval' only permits compiling WASM.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self' https: wss: http://127.0.0.1:* http://localhost:* data:; worker-src 'self' blob:; frame-src 'self'; child-src 'self' blob:; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000

# The Anon-RPC sandbox page: framed by our own page only, at an opaque origin
# (the harness adds sandbox="allow-scripts"). It starts the anonymity network's
# worker from a blob: URL (data: on Firefox); networks such as Nym and Tor run
# WASM inside it and may fetch over https/wss.
/anon-rpc-iframe.html
  ! Content-Security-Policy
  ! X-Frame-Options
  Content-Security-Policy: default-src 'none'; script-src 'self' blob: data: 'wasm-unsafe-eval'; worker-src blob: data:; connect-src https: wss:; frame-ancestors 'self'; base-uri 'none'; form-action 'none'; object-src 'none'

# Same rules if the extensionless form is ever requested.
/anon-rpc-iframe
  ! Content-Security-Policy
  ! X-Frame-Options
  Content-Security-Policy: default-src 'none'; script-src 'self' blob: data: 'wasm-unsafe-eval'; worker-src blob: data:; connect-src https: wss:; frame-ancestors 'self'; base-uri 'none'; form-action 'none'; object-src 'none'
