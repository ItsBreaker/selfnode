# Copy to .env (gitignored) and fill in locally. Never commit real values.
# The generate-keys script writes the two private keys below for you without
# printing them: `pnpm --filter scripts keys:generate`.

# Sepolia-only test wallet used by Phase 0 spikes and scripts/seed-pool.ts.
SEPOLIA_TEST_PRIVATE_KEY=0x_your_sepolia_test_key_here

# Arkiv mirror writer wallet (owner of all mirrored entities).
ARKIV_MIRROR_PRIVATE_KEY=0x_your_arkiv_mirror_key_here

# Arkiv access key for writes from the mirror script only. Never used by the web app.
ARKIV_ACCESS_KEY=your_arkiv_access_key_here
